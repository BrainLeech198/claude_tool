__pycache__/
*.pyc
*.pyo

# PyInstaller 产物。注意 build/ 本身是要提交的（spec、iss、图标在那儿），
# 只有 _work/ 是中间产物。
build/_work/
dist/

# Linux 那边打包用的虚拟环境（build/打包.sh 建的），装的是 PyInstaller，
# 跟打出来的程序无关——程序自己只用标准库。
build/_venv/

# Inno Setup 产物
Output/
*.iss.bak

# claude_tool.iss 用 #include 吃的那个版本号：由 build/write_version.py 按
# claude_tool/__init__.py 里的 __version__ 现生成，是产物不是源码。
build/_version.iss

# 本地调试留下的探针、截图、临时脚本
_probe_*.py
_probe_*.png
# 官网那一页的渲染探针是 node 写的，同一条规矩
_probe_*.js
# Linux 那边的系统层探针是 shell 写的
_probe_*.sh
_shot*.py
_shot*.png
_zoom*.py
_zoom*.png
_dlg*.py
_dlg*.png
_*.png

# 编辑器
.vscode/
.idea/
*.swp
